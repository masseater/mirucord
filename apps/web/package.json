{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc --noEmit",
    "steiger": "steiger ./src",
    "db:generate": "drizzle-kit generate",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "auth:generate": "auth generate --config src/shared/auth/auth.server.ts --output src/shared/auth/generated/auth.table.ts --yes",
    "fallow": "fallow --production --quiet --format compact && fallow dupes --quiet --format compact && fallow security --fail-on-issues --quiet",
    "db:check": "drizzle-kit check && drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"'",
    "deploy": "alchemy deploy",
    "otel": "docker run --rm -d --name otel-lgtm -p 3000:3000 -p 3200:3200 -p 4317:4317 -p 4318:4318 grafana/otel-lgtm:0.36.0",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@discordjs/rest": "catalog:",
    "@distilled.cloud/aws": "catalog:",
    "@effect/atom-react": "catalog:stack",
    "@modelcontextprotocol/server": "catalog:",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "catalog:stack",
    "@sapphire/bitfield": "catalog:",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "catalog:stack",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "catalog:stack",
    "better-auth": "catalog:stack",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "discord-api-types": "catalog:",
    "drizzle-orm": "catalog:stack",
    "effect": "catalog:stack",
    "elysia": "catalog:stack",
    "jose": "catalog:",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.28.0",
    "simple-icons": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:stack",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "alchemy": "catalog:stack",
    "auth": "1.7.7",
    "drizzle-kit": "catalog:stack",
    "steiger": "catalog:stack",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
