{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test", "r2bench", "*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "#/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/http/FetchHttpClient#layer",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClient#execute",
          "effect/http/HttpClientError#HttpClientError",
          "effect/http/HttpClientRequest#HttpClientRequest",
          "effect/http/HttpClientRequest#bodyJsonUnsafe",
          "effect/http/HttpClientRequest#bodyText",
          "effect/http/HttpClientRequest#get",
          "effect/http/HttpClientRequest#patch",
          "effect/http/HttpClientRequest#post",
          "effect/http/HttpClientRequest#setHeaders",
          "effect/http/HttpClientResponse#filterStatusOk",
          "effect/http/HttpClientResponse#schemaBodyJson",
          "effect/reactivity/Atom"
        ]
      }
    ]
  }
}
