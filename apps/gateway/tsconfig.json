{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeSocket#layerWebSocketConstructor",
          "effect/http/FetchHttpClient#layer",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClient#execute",
          "effect/http/HttpClientError#HttpClientError",
          "effect/http/HttpClientRequest#HttpClientRequest",
          "effect/http/HttpClientRequest#bodyText",
          "effect/http/HttpClientRequest#post",
          "effect/http/HttpClientRequest#setHeaders",
          "effect/http/HttpClientResponse#filterStatusOk"
        ]
      }
    ]
  }
}
