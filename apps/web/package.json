{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc",
    "test": "vp exec vp test run",
    "steiger": "steiger ./src",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.guild.config.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "auth:generate": "auth generate --config auth.config.ts --output src/shared/auth/generated/auth.table.ts --yes",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "db:check": "drizzle-kit check && drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"' && drizzle-kit check --config drizzle.guild.config.ts && drizzle-kit generate --config drizzle.guild.config.ts --explain --output json | grep -q '\"status\":\"no_changes\"'",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@effect/atom-react": "catalog:stack",
    "@modelcontextprotocol/server": "catalog:",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "catalog:stack",
    "@repo/ingest-util-gateway-contract": "workspace:*",
    "@repo/shared-util-app-name": "workspace:*",
    "@repo/shared-util-discord": "workspace:*",
    "@sapphire/bitfield": "catalog:",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "catalog:stack",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "catalog:stack",
    "better-auth": "catalog:stack",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "dfx": "catalog:",
    "discord-api-types": "catalog:",
    "drizzle-orm": "catalog:stack",
    "effect": "catalog:stack",
    "elysia": "catalog:stack",
    "jose": "catalog:",
    "js-base64": "catalog:",
    "lucide-react": "catalog:",
    "ml-kmeans": "catalog:",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0",
    "simple-icons": "catalog:",
    "tailwind-merge": "catalog:",
