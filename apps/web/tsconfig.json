{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test", "*.ts"],
  "compilerOptions": {
    "types": ["vite/client", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "#/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["effect/http/FetchHttpClient#layer", "effect/reactivity/Atom"]
      }
    ]
  }
}
